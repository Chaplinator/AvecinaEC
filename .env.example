# Copiar a .env.local. NUNCA versionar valores reales.
# Solo las variables NEXT_PUBLIC_* llegan al navegador; las demás son solo de servidor.

# Supabase (públicas: URL y anon key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor. Nunca en NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis (solo servidor)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
